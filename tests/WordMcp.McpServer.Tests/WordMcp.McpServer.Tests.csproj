    <AssemblyName>WordMcp.McpServer.Tests</AssemblyName>
    <RootNamespace>WordMcp.McpServer.Tests</RootNamespace>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <NoWarn>$(NoWarn);CS1591;CA1707;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
